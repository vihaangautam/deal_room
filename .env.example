# Local development values. Copy to .env and keep .env out of git.
# Phase 3 (hosted) swaps the OCI_* values for real OCI Object Storage
# credentials and endpoint — see ARCHITECTURE.md §11 and §17.

DATABASE_URL=postgresql+asyncpg://lilkis_app:localdevpassword@localhost:5433/lilkis
# Admin/superuser connection — migrations only (DDL + GRANT/REVOKE need
# owner privileges the restricted lilkis_app role doesn't have).
DATABASE_URL_ADMIN=postgresql+asyncpg://lilkis_admin:localdevpassword@localhost:5433/lilkis
POSTGRES_ADMIN_PASSWORD=localdevpassword
POSTGRES_APP_PASSWORD=localdevpassword

SECRET_KEY=dev-secret-change-me-64-chars-minimum-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# S3Mock (local stand-in for OCI Object Storage; same boto3/S3 API).
# S3Mock does not validate credentials, so these values are placeholders.
OCI_ENDPOINT_URL=http://localhost:9000
OCI_BUCKET=lilkis-deals
OCI_ACCESS_KEY_ID=local-dev-key
OCI_SECRET_ACCESS_KEY=local-dev-secret
OCI_ADMIN_ACCESS_KEY_ID=local-dev-key
OCI_ADMIN_SECRET_ACCESS_KEY=local-dev-secret

ENVIRONMENT=development

VITE_API_URL=http://localhost:8002
