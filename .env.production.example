# Production environment for docker-compose.prod.yml.
#
#   cp .env.production.example .env
#   chmod 600 .env
#
# Everything here is read by the containers at RUN time, with one
# exception that is called out below — get that one wrong and the site
# loads perfectly while every request goes to the visitor's own machine.
#
# .env is gitignored and must stay that way.


# ─── Build time vs run time ──────────────────────────────────────────────
#
# VITE_API_URL is NOT in this file, on purpose.
#
# Vite inlines it into the JavaScript bundle when the image is built, so
# it is a build arg in docker-compose.prod.yml, not an environment
# variable. Setting it here, or on the running container, does nothing at
# all — the value is already compiled in.
#
# It is deliberately empty in the compose file, which makes the frontend
# call the API on its own origin through nginx. That is what keeps the
# session cookie same-origin, so SameSite=Strict (PRD F1) holds and CORS
# never comes into it. Only set it if you split the API onto its own
# hostname, and expect to revisit the cookie policy if you do.


# ─── Database ────────────────────────────────────────────────────────────
#
# Two roles (ARCHITECTURE.md §2.1): lilkis_admin owns the schema and runs
# migrations; lilkis_app is what the application connects as and has no
# UPDATE or DELETE on audit_log.
#
# POSTGRES_APP_PASSWORD must match the password in db-init/01-app-role.sql,
# which runs once when the data volume is first created. If you change it
# here later, change it in the database too — the init script will not run
# a second time.
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_PASSWORD=


# ─── Session signing ─────────────────────────────────────────────────────
#
# 64 random characters. Rotating it invalidates every session, which is
# the intended way to force everyone out.
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=


# ─── Public origin ───────────────────────────────────────────────────────
#
# The URL people actually type, scheme included and no trailing slash.
# Used for CORS.
#
#   PUBLIC_ORIGIN=https://deals.lilkis.in
PUBLIC_ORIGIN=


# ─── Object storage (OCI, S3-compatible) ─────────────────────────────────
#
# Two key pairs, which is not belt-and-braces: the application key has no
# delete permission at all, so a bug or a compromised app container cannot
# destroy a document. Only the purge job uses the admin key, and only to
# delete objects whose rows are already archived or rejected
# (app/jobs/purge.py).
#
# Create both as Customer Secret Keys under the OCI user, and set the
# bucket's own policy so the app key really is read/write-without-delete —
# the code calls the right client, but the permission is what enforces it.
#
# Endpoint shape:
#   https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
OCI_ENDPOINT_URL=
OCI_BUCKET=lilkis-deals

OCI_ACCESS_KEY_ID=
OCI_SECRET_ACCESS_KEY=

OCI_ADMIN_ACCESS_KEY_ID=
OCI_ADMIN_SECRET_ACCESS_KEY=


# ─── Cloudflare Tunnel ───────────────────────────────────────────────────
#
# Token from a tunnel created in the Cloudflare dashboard. Route its
# public hostname to http://web:8080 — the nginx container, not the API.
# Pointing it at the API serves no frontend and bypasses the proxy that
# keeps everything same-origin.
#
# Because the tunnel dials out, the VM needs no inbound firewall rules.
CLOUDFLARE_TUNNEL_TOKEN=


# ─── Not used ────────────────────────────────────────────────────────────
#
# ARCHITECTURE.md §10 lists SMTP_HOST, SMTP_USER, SMTP_PASSWORD and
# EMAIL_FROM. Nothing reads them: email is a PRD §3 non-goal and a Phase 3
# roadmap item. They are left out rather than left blank so nobody
# concludes that notifications are configured but broken.
